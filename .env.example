# Production Server Setup — config template
#
# Copy this file to `.env` and fill in values:
#   cp .env.example .env
#
# Any value left blank or missing will trigger an interactive prompt at run time,
# UNLESS NONINTERACTIVE=true, in which case missing required values cause the
# script to exit with code 2 BEFORE any system changes are made.

# --- Timezone ---------------------------------------------------------------
# Examples: UTC, Asia/Shanghai, America/New_York, Europe/London
TIMEZONE=

# --- Hostname ---------------------------------------------------------------
# Example: web-prod-01
HOSTNAME=

# --- Firewall ---------------------------------------------------------------
# Set to "true" to apply rules, "false" to skip. Default: prompt.
FIREWALL_APPLY=

# Extra ports to open (comma-separated), in addition to the default 22/80/443.
# Examples:
#   5432/tcp           (PostgreSQL)
#   8080/tcp           (alternate HTTP)
#   3000:3010/tcp      (port range)
FIREWALL_EXTRA_PORTS=

# --- SSH public key ---------------------------------------------------------
# Your public key, as a single line. Example:
#   SSH_PUBLIC_KEY="ssh-ed25519 AAAA...rest-of-key... you@machine"
#
# NOTE: putting the key in `ssh_key.pub` (a sibling file) is the preferred
# approach — no escaping required and easy to .gitignore.
SSH_PUBLIC_KEY=

# If authorized_keys already exists and ssh_key.pub is not present in it,
# set to "true" to auto-append, "false" to skip, or leave blank to prompt.
SSH_PUBLIC_KEY_APPEND=

# --- Swap -------------------------------------------------------------------
# Size of swap file to create at /swapfile, in megabytes.
# Set to 0 (or leave blank) to skip swap configuration.
# Common values: 1024, 2048, 4096
SWAP_SIZE_MB=2048

# --- fail2ban ---------------------------------------------------------------
# Set to "true" to install/enable fail2ban with SSH jail, "false" to skip.
FAIL2BAN_ENABLED=true

# Ban duration for repeated SSH failures (e.g. 1h, 30m, 1d)
FAIL2BAN_BANTIME=1h

# Window of time over which maxretry counts (e.g. 10m, 1h)
FAIL2BAN_FINDTIME=10m

# Number of failures before banning
FAIL2BAN_MAXRETRY=5

# --- Behavior ---------------------------------------------------------------
# Set to "true" to skip all interactive prompts and fail fast on missing values.
# Useful for CI / cloud-init runs where every variable must be set.
NONINTERACTIVE=false

# --- apt update + upgrade ---------------------------------------------------
# Run "apt-get update && apt-get upgrade -y" as the first setup step.
# Set to "true" to update all packages on every run.
APT_UPGRADE=true

# Also run "apt-get autoremove -y" to clean up unused dependencies.
APT_AUTOREMOVE=false

# --- 3rd-party APT repositories (opt-in via --add-repo flag) ----------------
# Only runs when --add-repo / -r is passed. After adding repos, runs apt update.
#
# Format A (full): name|url|suite|components|key_url
# Format B (short, auto-detects suite + uses "main" component):
#   name|url
#
# Multiple repos separated by ';'.
# Suite is auto-detected from /etc/os-release if omitted.
# Key URL is optional — if omitted, you must add the signing key manually.
#
# Examples:
#   APT_REPOSITORIES="docker|https://download.docker.com/linux/ubuntu|$(. /etc/os-release && echo $UBUNTU_CODENAME)|stable|https://download.docker.com/linux/ubuntu/gpg"
#   APT_REPOSITORIES="docker|https://download.docker.com/linux/ubuntu"
APT_REPOSITORIES=""

# --- Baseline server packages (opt-in via --install-defaults / -p) -----------
# Space-separated list of packages every server should have.
# Comment out (prefix with #) or remove anything you don't want installed.
# Only runs when --install-defaults / -p is passed, or when DEFAULT_PACKAGES is
# non-empty in .env (auto-detection).
DEFAULT_PACKAGES="unzip zip p7zip-full vim nano htop curl wget git ca-certificates gnupg lsb-release bash-completion net-tools dnsutils mtr-tiny tcpdump ncat sysstat ncdu tmux screen jq ripgrep fd-find bat"
